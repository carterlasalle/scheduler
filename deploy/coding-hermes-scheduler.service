[Unit]
Description=Coding Hermes Fleet Scheduler
After=network.target hermes-gateway.service

[Service]
Type=simple
User=%i
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=30
ExecStartPre=-/usr/bin/pkill -f "hermes.*foreman"
ExecStartPre=-/usr/bin/pkill -f "duckbrain"
ExecStart=%h/coding-hermes-scheduler/bin/schedulerd \
  -db %h/.hermes/coding-hermes/scheduler.db \
  -listen 127.0.0.1:9090 \
  --namespace-mode \
  --max-concurrent 4 \
  --min-interval 30s \
  --tick-timeout 7200s \
  --gateway-url=http://127.0.0.1:8642 \
  --no-exec-fallback \
  --auto-disable-failure-rate 0.9
Restart=on-failure
RestartSec=30
MemoryMax=8G
StandardOutput=journal
StandardError=journal
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Gateway key comes ONLY from the 0600 env file below (API_SERVER_KEY) —
# never pass --gateway-key on the command line (ps-readable by any local user).
# main.go defaults --gateway-key to $API_SERVER_KEY, so no flag is needed.
#   /etc/coding-hermes/gateway.env  →  API_SERVER_KEY=<key>
EnvironmentFile=-/etc/coding-hermes/gateway.env

[Install]
WantedBy=default.target