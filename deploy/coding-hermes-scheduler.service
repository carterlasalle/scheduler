[Unit]
Description=Coding Hermes Fleet Scheduler
After=network.target

[Service]
Type=simple
User=hermes
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=30
ExecStart=/home/hermes/coding-herms-scheduler/bin/schedulerd \
  -db /home/hermes/.hermes/coding-hermes/scheduler.db \
  -config /home/hermes/coding-herms-scheduler/fleet.toml \
  -listen 127.0.0.1:9090 \
  -gateway-url= \
  -max-concurrent 5 \
  -min-interval 30s \
  -tick-timeout 600s
Restart=on-failure
RestartSec=30
MemoryMax=8G
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
